# =============================================================================
# Supabase Configuration — Copy to .env and fill in your values
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Get from: https://supabase.com/dashboard/project/_/settings/api
# Under "Project API keys", this is your anon/public key

VITE_SUPABASE_PUBLISHABLE_KEY=

# Get from: https://supabase.com/dashboard/project/_/settings/api
# Under "Project API keys", this is your publishable key (new format)

# =============================================================================
# PostHog Analytics (optional — analytics is disabled when this is blank)
# =============================================================================

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Get from: https://posthog.com/dashboard/project/_/settings
# Under "Project API Key". Use https://eu.i.posthog.com if your project is
# hosted in the EU region. The key is public and ships in the browser bundle;
# never put a PostHog personal API key in this file.
